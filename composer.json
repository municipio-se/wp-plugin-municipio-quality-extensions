{
  "name": "municipio/wp-plugin-municipio-quality-extensions",
  "description": "Runtime quality improvements for modern Municipio installations.",
  "type": "wordpress-plugin",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "composer/installers": "^2.3"
  },
  "require-dev": {
    "carthage-software/mago": "1.43.0",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "MunicipioQualityExtensions\\": "source/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MunicipioQualityExtensions\\Tests\\": "tests/"
    }
  },
  "extra": {
    "installer-name": "municipio-quality-extensions"
  },
  "config": {
    "allow-plugins": {
      "carthage-software/mago": true,
      "composer/installers": true
    }
  },
  "scripts": {
    "test": "php -d memory_limit=512M vendor/bin/phpunit --no-coverage",
    "lint": "vendor/bin/mago lint",
    "format": "vendor/bin/mago fmt"
  }
}
